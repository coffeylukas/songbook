# Copy to .env.local and replace every placeholder with a real value.
# .env.local is gitignored — never commit real keys. The schema that validates
# these lives in env.ts; a missing or malformed value fails `pnpm dev`/`pnpm build`
# immediately with the variable name in the error.

# --- Clerk (auth) -----------------------------------------------------------
# Dashboard -> API keys. The publishable key is client-safe; the secret key is
# server-only and must never get a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me

# --- Supabase (database / realtime) -----------------------------------------
# Dashboard -> Project Settings -> API keys. Use the new Publishable/Secret keys
# (`sb_publishable_...` / `sb_secret_...`), not the legacy anon/service_role JWTs
# — see "Supabase key naming" in docs/CONTEXT.md.
NEXT_PUBLIC_SUPABASE_URL=https://replace-me.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# Bypasses RLS. Server-only — never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace-me

# --- Escape hatch -----------------------------------------------------------
# Set SKIP_ENV_VALIDATION=1 to bypass the checks above. Intended only for
# contexts that build or boot the app without real credentials — CI lint/build
# jobs, Playwright runs from a clean checkout, Docker image builds. Off by
# default; never set it for a real deployment.

# --- Not validated by env.ts ------------------------------------------------
# The Supabase database password is a separate mechanism from the API keys: it's
# used by the Supabase CLI (`supabase link`, migrations) and direct Postgres
# connections, and no app code reads it. Keep it in your password manager or
# export it in your shell when running the CLI — it is intentionally not part of
# the app's env schema.
